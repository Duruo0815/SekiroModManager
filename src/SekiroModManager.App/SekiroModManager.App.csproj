<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>只狼 MOD 管理器</ApplicationTitle>
    <RootNamespace>SekiroModManager.App</RootNamespace>
    <AssemblyName>SekiroModManager.App</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SekiroModManager.Core\SekiroModManager.Core.csproj" />
  </ItemGroup>

</Project>
