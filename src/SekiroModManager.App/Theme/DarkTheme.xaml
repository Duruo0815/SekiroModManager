<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Mode Colors and Brushes -->
    <Color x:Key="BgMainColor">#121214</Color>
    <Color x:Key="BgSurfaceColor">#1c1c21</Color>
    <Color x:Key="BgSurfaceAltColor">#25252b</Color>
    <Color x:Key="BgInputColor">#16161a</Color>
    <Color x:Key="BorderSubtleColor">#2d2d38</Color>
    <Color x:Key="BorderFocusColor">#e53e3e</Color>

    <Color x:Key="TextPrimaryColor">#f4f4f7</Color>
    <Color x:Key="TextSecondaryColor">#a0a0af</Color>
    <Color x:Key="TextMutedColor">#646473</Color>

    <Color x:Key="AccentPrimaryColor">#dc2626</Color>
    <Color x:Key="AccentHoverColor">#ef4444</Color>
    <Color x:Key="AccentActiveColor">#b91c1c</Color>
    <Color x:Key="AccentTextColor">#ffffff</Color>

    <Color x:Key="SuccessColor">#10b981</Color>
    <Color x:Key="SuccessBgColor">#132e22</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>
    <Color x:Key="WarningBgColor">#312610</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="DangerBgColor">#331417</Color>

    <Color x:Key="TableAltRowColor">#17171c</Color>
    <Color x:Key="ScrollThumbColor">#3e3e4f</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMainColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgSurfaceAltBrush" Color="{StaticResource BgSurfaceAltColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentActiveBrush" Color="{StaticResource AccentActiveColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />

    <SolidColorBrush x:Key="TableAltRowBrush" Color="{StaticResource TableAltRowColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
</ResourceDictionary>
