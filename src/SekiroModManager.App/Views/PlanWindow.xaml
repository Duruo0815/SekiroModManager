<Window x:Class="SekiroModManager.App.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="部署计划与冲突排查"
        Height="580" Width="820"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/SekiroModManager.App;component/app.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="部署计划与文件冲突分析" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="在正式挂载到 mods/ 前，您可以在此核对生效条目及被高优先级覆盖的冲突文件。"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Stats Overview Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="启用 MOD 源文件总计" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtTotalFiles" Text="0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="计划实际部署生效条目" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtDeployFiles" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="被覆盖的冲突文件数" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtConflictFiles" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detail Tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- Conflicts Tab -->
            <TabItem x:Name="TabConflicts" Header="⚠️ 冲突明细" FontSize="13">
                <Border Style="{StaticResource CardPanel}" Margin="0,8,0,0">
                    <DataGrid x:Name="GridConflicts" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                              RowBackground="{DynamicResource BgSurfaceBrush}" AlternatingRowBackground="{DynamicResource TableAltRowBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgSurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="游戏相对路径" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="胜出方 (生效的 MOD)" Binding="{Binding WinnerModName}" Width="*" />
                            <DataGridTextColumn Header="被覆盖方 (较低优先级)" Binding="{Binding LoserModName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Planned Files Tab -->
            <TabItem x:Name="TabFiles" Header="📄 生效清单" FontSize="13">
                <Border Style="{StaticResource CardPanel}" Margin="0,8,0,0">
                    <DataGrid x:Name="GridFiles" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                              RowBackground="{DynamicResource BgSurfaceBrush}" AlternatingRowBackground="{DynamicResource TableAltRowBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgSurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="游戏相对路径" Binding="{Binding RelativePath}" Width="2*" />
                            <DataGridTextColumn Header="归属 MOD" Binding="{Binding WinnerModName}" Width="*" />
                            <DataGridTextColumn Header="预计挂载方式" Binding="{Binding PlannedKind}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtWarningNotice" Text="" VerticalAlignment="Center"
                       Foreground="{DynamicResource WarningBrush}" FontSize="12" MaxWidth="500" TextTrimming="CharacterEllipsis" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="关闭" Style="{StaticResource BtnSecondary}" Width="90" Click="BtnClose_Click" Margin="0,0,10,0" />
                <Button Content="⚡ 确认并立即部署" Style="{StaticResource BtnPrimary}" Padding="16,6" Click="BtnDeploy_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
